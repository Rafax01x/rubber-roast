{
  "activationEvents": [],
  "author": "Rafax01x",
  "categories": [
    "Linters"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rubber-roast.roastFile",
        "title": "Roast File"
      }
    ]
  },
  "description": "VS Code extension that roasts your code on save — empty catch blocks, excess console.log, and TODO/FIXME comments, with funny Indonesian and English messages.",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "displayName": "Rubber Roast",
  "engines": {
    "vscode": "^1.144.0"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "roast",
    "funny",
    "humor",
    "code-quality",
    "linter"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "rubber-roast",
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rafax01x/rubber-roast.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "npx mocha --ui tdd out/test/scanner.test.js out/test/roasts.test.js",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "version": "1.0.0"
}
